    {
      "name": "Listar reservas con filtros, orden y paginación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings?room={{roomId}}&status=apartada&date={{bookingDate}}&sort=-startHour&page=1&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Listado paginado', () => { pm.expect(b.limit).to.eql(5); pm.expect(b.total).to.eql(2); });",
              "pm.test('Orden descendente por startHour', () => pm.expect(b.data.map(x => x.startHour)).to.eql([12, 10]));",
              "pm.test('Sala y banda con populate', () => { pm.expect(b.data[0].room.name).to.be.a('string'); pm.expect(b.data[0].band.name).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
