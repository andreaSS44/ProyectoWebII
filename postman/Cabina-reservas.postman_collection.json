{
  "info": {
    "name": "Cabina - Persona 3: reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el environment Cabina y la API integrada. Crea su propia sala, banda y músicos, prueba las reglas de reservas y al final cancela las reservas y elimina lo que creó. Las reservas canceladas quedan guardadas. Los préstamos de equipo requieren el módulo de persona 4; ver README."
  },
  "item": [
    {
      "name": "Crear sala para las pruebas (capacidad 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Sala P3 {{$guid}}\",\"capacity\":1,\"floor\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fecha de las reservas: dentro de 30 días, para que nunca quede en el pasado.",
              "const d = new Date(); d.setDate(d.getDate() + 30);",
              "const fecha = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;",
              "pm.collectionVariables.set('bookingDate', fecha);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('roomId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
