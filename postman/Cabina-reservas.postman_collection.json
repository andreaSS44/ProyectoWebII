    {
      "name": "Crear reserva 10-12",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"room\":\"{{roomId}}\",\"band\":\"{{bandId}}\",\"date\":\"{{bookingDate}}\",\"startHour\":10,\"endHour\":12,\"notes\":\"Ensayo general\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.environment.set('bookingId', b._id);",
              "pm.test('Apartada por defecto', () => pm.expect(b.status).to.eql('apartada'));",
              "pm.test('durationHours calculado', () => pm.expect(b.durationHours).to.eql(2));",
              "pm.test('Fecha a medianoche UTC', () => pm.expect(b.date).to.eql(pm.collectionVariables.get('bookingDate') + 'T00:00:00.000Z'));"
            ]
          }
        }
      ]
    },
