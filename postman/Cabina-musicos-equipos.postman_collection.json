{
  "info": {
    "name": "Cabina - Persona 2: músicos y equipos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el environment Cabina y la API integrada. Crea y elimina sus propios recursos. Las pruebas de préstamos requieren el módulo de persona 4; ver README."
  },
  "item": [
    {
      "name": "Crear banda para las pruebas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bands",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Banda P2 {{$guid}}\", \"contactName\": \"Contacto P2\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('bandId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear músico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/musicians",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Ana Pérez\", \"instrument\": \"guitarra\", \"band\": \"{{bandId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('musicianId', pm.response.json()._id); pm.test('Activo inicialmente', () => pm.expect(pm.response.json().active).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar músicos con filtros y paginación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/musicians?band={{bandId}}&active=true&search=Ana&sort=-name&page=1&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Listado paginado', () => { const b = pm.response.json(); pm.expect(b.limit).to.eql(5); pm.expect(b.data.some(x => x._id === pm.environment.get('musicianId'))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar músico",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/musicians/{{musicianId}}"
